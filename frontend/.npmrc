# Privy 3.48 peer-optionally depends on `permissionless` (the ERC-4337 smart
# account library), which peer-optionally wants ox ^0.8, while viem 2.57 brings
# ox 0.14. Valet does not use smart wallets — the recipient's actions are
# signature-relayed instead of sponsored through a bundler — so permissionless
# is never loaded and the clash is only npm trying to satisfy a peerOptional of
# a peerOptional.
#
# This lives in a file rather than a local flag so `npm install` on Vercel
# resolves the same way it does here.
legacy-peer-deps=true
