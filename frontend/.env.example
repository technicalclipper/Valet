# --- which chain -------------------------------------------------------------
# local anvil fork of Monad mainnet (development; real Kuru, no real money)
NEXT_PUBLIC_CHAIN_ID=143
NEXT_PUBLIC_RPC_URL=http://localhost:8545
NEXT_PUBLIC_CHAIN_LABEL="local fork"
NEXT_PUBLIC_EXPLORER_URL=https://monadexplorer.com

# Monad mainnet (the demo and the deployed app)
# NEXT_PUBLIC_RPC_URL=https://rpc.monad.xyz
# NEXT_PUBLIC_CHAIN_LABEL="Monad mainnet"

# --- deployed contracts ------------------------------------------------------
NEXT_PUBLIC_VALET_ADDRESS=
# block Valet was deployed at; log queries start here rather than at 0
NEXT_PUBLIC_DEPLOY_BLOCK=
NEXT_PUBLIC_KURU_MARKET=0x065C9d28E428A0db40191a54d33d5b7c71a9C394
NEXT_PUBLIC_USDC=0x754704Bc059F8C67012fEd69BC8A327a5aafb603

# --- Privy -------------------------------------------------------------------
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- policy extraction (optional; rules handle the common phrasings) ---------
# Only needed for sentences the rule extractor cannot parse. The demo path
# never calls out, so a missing key degrades gracefully rather than breaking.
OPENAI_API_KEY=

# --- the agent ---------------------------------------------------------------
# Server-side only. Must be the holder the capsule was claimed to. It can call
# execute() and nothing else — the contract's role split bounds what it can do.
AGENT_PRIVATE_KEY=

# --- the relayer -------------------------------------------------------------
# Server-side only. Submits signed claims, pauses, hand-backs and escalation
# approvals, and pays their gas so the people signing never need any. It can
# forge nothing: the contract checks every signature itself.
RELAYER_PRIVATE_KEY=

# --- the keeper --------------------------------------------------------------
# Wakes the agent once in each new window, so a capsule trades on schedule with
# nobody watching. Runs inside the server every KEEPER_INTERVAL_MS (0 = off).
# On serverless, set it to 0 and call GET /api/keeper/tick from a cron instead;
# CRON_SECRET, if set, must arrive as "Authorization: Bearer <secret>".
KEEPER_INTERVAL_MS=15000
CRON_SECRET=
